# Copier en .env (jamais commité). Tout est lu par lib/config.mjs.

# --- Environnement cible (staging uniquement) ---
E2E_DOMAIN=staging.mairie360-eip.fr
# Front dont l'hôte relaie /bff/admin/* vers BFF_user (à confirmer au premier `npm run doctor`)
E2E_API_FRONT=admin

# --- Compte admin de base (déjà existant sur staging) ---
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# --- E-mail de test réel. Les comptes créés utilisent des alias « +e2e-… »
#     (ex. vous+e2e-1234-newcomer@gmail.com), tous livrés dans cette boîte.
E2E_MAILBOX=
# Clé Resend en accès complet (lecture des e-mails envoyés par staging)
RESEND_API_KEY=

# --- Base et Redis via `scripts/port-forward.sh` ---
E2E_DB_HOST=127.0.0.1
E2E_DB_PORT=55432
E2E_DB_NAME=mairie_db_staging
E2E_DB_USER=e2e_readonly
E2E_DB_PASSWORD=
E2E_REDIS_HOST=127.0.0.1
E2E_REDIS_PORT=55379
E2E_REDIS_USERNAME=admin
E2E_REDIS_PASSWORD=

# --- Cluster (port-forward) ---
E2E_KUBE_CONTEXT=staging
E2E_NAMESPACE=mairie360-staging
E2E_RELEASE=staging
