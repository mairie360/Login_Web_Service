{
  "name": "login_web_service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "contracts:generate": "node scripts/contracts.mjs --generate",
    "contracts:check": "node scripts/contracts.mjs --check",
    "contracts:sync": "node scripts/contracts.mjs --sync",
    "test:contracts": "node --test tests/*.test.cjs",
    "test:node": "mkdir -p coverage && c8 --include='src/**' --reporter=text --reporter=lcov --check-coverage --lines=60 --functions=60 --branches=60 node --enable-source-maps --test --test-concurrency=1 --experimental-test-coverage --test-coverage-branches=60 --test-coverage-functions=60 --test-coverage-lines=60 --test-coverage-include='src/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/node-lcov.info tests/*.test.cjs",
    "test:components": "vitest run",
    "test": "npm run test:node && npm run test:components"
  },
  "dependencies": {
    "@mairie360/bff-user-openapi": "0.0.0-dev.46a698bb9adbf3c86a5517b4c958b379cb03fe70",
    "@mairie360/lib-components": "0.8.0",
    "next": "16.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "next": {
      ".": "$next",
      "postcss": "^8.5.23",
      "sharp": "^0.35.5"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "c8": "12.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jest-axe": "11.0.0",
    "jsdom": "30.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.2"
  }
}
